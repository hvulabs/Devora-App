{
  "expo": {
    "name": "Devora",
    "slug": "devora-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "devora",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#15132A",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#15132A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devora.app",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "appleTeamId": "R74UA9567Y"
    },
    "android": {
      "package": "com.devora.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15132A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#7C5CFF"
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
